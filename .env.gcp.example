# .env.gcp.example
# Google Cloud Platform & Cloud Run Environment Template for FinanceFlow

# ── GCP Project & Cloud Run Settings ──────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=financeflow-repo
GCP_SERVICE_NAME=financeflow-app

# ── Application Runtime ───────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-64-char-string
PORT=8080

# ── Database (Hosted PostgreSQL / Supabase) ──────────────────────────────
# Use transaction pooling / connection pooler URI on Supabase port 6543
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres

# ── Redis (Caching & Flask-SocketIO Backplane) ───────────────────────────
# e.g. Upstash Redis (rediss://default:[PASSWORD]@[HOST]:[PORT]) or GCP Memorystore
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379/0

# ── External AI & Finance APIs ───────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
OXR_APP_ID=your_open_exchange_rates_app_id

# ── Mail & OAuth (Optional) ──────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

